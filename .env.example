# LedgerGuard - local environment template.
#
# Copy to .env and fill in. .env is gitignored; this file is not, so it must
# never contain a real value.
#
#   Copy-Item .env.example .env

# --- Phase 11: LLM narrative generation (GroqCloud) -------------------------
# Leave empty to run the system exactly as Phase 10 did: every narrative comes
# from the deterministic templates. That is a supported mode, not a degraded
# one, and it is how the test suite runs.
#
# Get a key from https://console.groq.com/keys
LEDGERGUARD_GROQ_API_KEY=

# Optional overrides.
# LEDGERGUARD_LLM_ENABLED=true
# LEDGERGUARD_GROQ_MODEL=llama-3.1-8b-instant

# --- Infrastructure (defaults in application.yml are local-dev only) --------
# LEDGERGUARD_DB_URL=jdbc:postgresql://localhost:5432/ledgerguard
# LEDGERGUARD_DB_USER=ledgerguard
# LEDGERGUARD_DB_PASSWORD=ledgerguard
# LEDGERGUARD_KAFKA_BOOTSTRAP=localhost:9092
